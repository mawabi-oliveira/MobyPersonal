<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Perfil - Moby</title>
    <link rel="stylesheet" href="/css/style.css">
</head>
<body class="bg-[#f2f2f2] min-h-screen flex flex-col font-sans">
    <header class="bg-[#552482] text-white p-4 flex justify-center items-center shadow-md">
        <h1 class="m-0 text-xl font-semibold tracking-wide">Perfil</h1>
    </header>

    <main class="flex-1 flex justify-center items-start p-4">
        <section class="bg-white p-6 rounded-xl shadow-md my-2 mx-auto w-full max-w-[800px]">
            <h2 class="text-center text-xl font-bold mb-1">Olá, <%= nom_usuario %>!</h2>
            <h2 class="text-center text-lg text-gray-600 font-medium mb-4">Estes são alguns de seus livros</h2>
           
            <% if (livros.length > 0) { %>
                <div class="bg-[#f2f2f2] p-4 rounded-xl mt-4">
                    <ul class="grid grid-cols-[repeat(auto-fill,minmax(230px,1fr))] gap-4 list-none p-0">
                        <% livros.forEach(livro => { %>
                            <li class="bg-white p-4 rounded-lg shadow-sm leading-relaxed flex flex-col justify-between">
                                <div>
                                    <h3 class="mt-0 mb-2 text-[#552482] text-[1.1rem] font-bold truncate"><%= livro.titulo %></h3>
                                    <p class="text-sm text-gray-700"><strong>Autor:</strong> <%= livro.autor %></p>
                                    <p class="text-sm text-gray-700"><strong>Gênero:</strong> <%= livro.genero %></p>
                                    <p class="text-sm text-gray-700"><strong>Ano:</strong> <%= livro.ano_de_publicacao %></p>
                                </div>
                                <p class="text-sm text-gray-600 mt-2 text-xs line-clamp-3"><strong>Sinopse:</strong> <%= livro.sinopse %></p>
                            </li>
                        <% }); %>
                    </ul>
                </div>
            <% } else { %>
                <p class="text-center text-gray-500 my-6">Você ainda não tem livros adicionados. Adicione um agora!</p>
            <% } %>
         
            <div class="mt-6 text-center">
                <a href="/adicionar" class="bg-[#552482] text-white px-5 py-2.5 rounded-lg no-underline inline-block font-bold transition-colors hover:bg-[#401c4a] shadow-md">
                    Adicionar Livro
                </a>
            </div>
        </section>
    </main>

    <footer class="bg-[#552482] text-white p-4 text-center mt-auto">
        <nav>
            <ul class="list-none p-0 m-0 flex justify-center gap-5">
                <li><a href="/home-logado" class="text-white no-underline hover:underline">Página Inicial</a></li>
                <li><a href="/logout" class="text-white no-underline hover:underline">Sair</a></li>
            </ul>
        </nav>
    </footer>
</body>
</html>