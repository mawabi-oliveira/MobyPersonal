<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Estante - Moby</title>
    <link rel="stylesheet" href="/css/style.css">
</head>
<body class="bg-[#D9D6D6] text-[#333] min-h-screen flex flex-col font-sans">
    <header class="flex justify-between items-center p-4 bg-white shadow-sm">
        <h1 class="text-[#646464] text-2xl font-semibold">Estante</h1>
        <a href="/home-logado" class="hover:opacity-80 transition-opacity">
            <img src="img/moby.png" alt="moby-icon" class="w-[45px] h-auto">
        </a>
    </header>

    <main class="flex justify-center items-center flex-1 p-5">
        <section class="bg-white p-6 rounded-xl max-w-[500px] w-full shadow-lg">
            <h2 class="mt-0 mb-5 text-xl font-bold">Adicione Um Novo Livro</h2>
            <% if (typeof mensagem !== 'undefined') { %>
                <p class="<%= tipo === 'sucesso' ? 'text-green-600' : 'text-red-600' %> font-bold mb-4"><%= mensagem %></p>
            <% } %>
            <form id="adicionarLivroForm" action="/adicionarLivro" method="post" class="flex flex-col">
                <div class="mb-4">
                    <label for="titulo" class="font-bold block mb-1">Título:</label>
                    <input type="text" id="titulo" name="titulo" placeholder="Insira o título" required
                           class="p-2.5 border border-gray-300 rounded-lg w-full text-base outline-none bg-white focus:border-[#552482] focus:ring-1 focus:ring-[#552482]">
                </div>
                <div class="mb-4">
                    <label for="autor" class="font-bold block mb-1">Autor:</label>
                    <input type="text" id="autor" name="autor" placeholder="Insira o autor" required
                           class="p-2.5 border border-gray-300 rounded-lg w-full text-base outline-none bg-white focus:border-[#552482] focus:ring-1 focus:ring-[#552482]">
                </div>
                <div class="mb-4">
                    <label for="genero" class="font-bold block mb-1">Gênero:</label>
                    <input type="text" id="genero" name="genero" placeholder="Insira o gênero" required
                           class="p-2.5 border border-gray-300 rounded-lg w-full text-base outline-none bg-white focus:border-[#552482] focus:ring-1 focus:ring-[#552482]">
                </div>
                <div class="mb-4">
                    <label for="ano" class="font-bold block mb-1">Ano de Publicação:</label>
                    <input type="number" id="ano" name="ano_de_publicacao" placeholder="Insira o ano de publicação" min="1000" max="2026" required
                           class="p-2.5 border border-gray-300 rounded-lg w-full text-base outline-none bg-white focus:border-[#552482] focus:ring-1 focus:ring-[#552482]">
                </div>
                <div class="mb-4">
                    <label for="sinopse" class="font-bold block mb-1">Sinopse:</label>
                    <textarea id="sinopse" name="sinopse" placeholder="Insira a sinopse" required
                              class="p-2.5 border border-gray-300 rounded-lg w-full h-[120px] resize-none text-base outline-none bg-white focus:border-[#552482] focus:ring-1 focus:ring-[#552482]"></textarea>
                </div>
                <button type="submit" class="p-3 bg-[#552482] text-white border-none rounded-lg cursor-pointer w-full text-base font-bold mt-2 transition-colors duration-300 hover:bg-[#401c4a]">
                    Adicionar Livro
                </button>
            </form>
            <p id="mensagem"></p>
        </section>
    </main>

    <footer class="bg-[#552482] text-white p-4 text-center mt-auto">
        <nav>
            <ul class="list-none p-0 m-0 flex justify-center flex-wrap gap-5">
                <li><a href="/remover" class="text-white no-underline hover:underline">Remover um livro</a></li>
                <li><a href="/editar" class="text-white no-underline hover:underline">Editar um livro</a></li>
                <li><a href="/visualizar" class="text-white no-underline hover:underline">Visualizar seus livros</a></li>
            </ul>
        </nav>
    </footer>
</body>
</html>